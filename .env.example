# ---------------------------------------------------------------------------
# Financial Intelligence Lakehouse - environment configuration
#
#   cp .env.example .env
#
# Everything here has a working default, so the demo runs with an EMPTY .env.
# Secrets belong here and ONLY here; config/settings.yaml holds non-secret
# tunables and is safe to commit.
# ---------------------------------------------------------------------------

# --- environment -----------------------------------------------------------
FIL_ENVIRONMENT=local
FIL_LOG_LEVEL=INFO
FIL_LOG_FORMAT=console          # console | json

# --- execution engine ------------------------------------------------------
# pandas -> runs anywhere, no JVM required (default)
# spark  -> PySpark + Delta Lake, only available inside the `spark` container
FIL_ENGINE=pandas

# --- metadata store --------------------------------------------------------
# Leave FIL_POSTGRES_DSN empty to use the zero-setup SQLite fallback.
# With docker compose up postgres, use the DSN below.
FIL_POSTGRES_DSN=
# FIL_POSTGRES_DSN=postgresql+psycopg://fil:fil_local_password@localhost:5432/financial_intelligence
POSTGRES_USER=fil
POSTGRES_PASSWORD=fil_local_password
POSTGRES_DB=financial_intelligence
POSTGRES_PORT=5432

# --- graph database (optional; pipeline degrades gracefully) ---------------
FIL_GRAPH_ENABLED=true
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=fil_local_password
NEO4J_DATABASE=neo4j

# --- USAspending public API (no authentication required) ------------------
USASPENDING_BASE_URL=https://api.usaspending.gov
USASPENDING_PAGE_SIZE=100
USASPENDING_TIMEOUT=30
USASPENDING_MAX_RETRIES=4
USASPENDING_RATE_LIMIT_PER_SEC=4
# Set to false to skip all outbound calls and use the synthetic federal-spending
# fallback source instead (CI sets this to false).
USASPENDING_ENABLED=true

# --- local source-system API ----------------------------------------------
SOURCE_API_HOST=127.0.0.1
SOURCE_API_PORT=8001
SOURCE_API_BASE_URL=http://127.0.0.1:8001

# --- serving API -----------------------------------------------------------
SERVING_API_HOST=127.0.0.1
SERVING_API_PORT=8000

# --- dashboard -------------------------------------------------------------
DASHBOARD_PORT=8501

# --- Kaggle (optional, only for scripts/download_data.py) -----------------
# https://www.kaggle.com/settings -> API -> Create New Token
KAGGLE_USERNAME=
KAGGLE_KEY=
